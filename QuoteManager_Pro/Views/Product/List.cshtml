@model List<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1>Our Products</h1>
        <p class="lead">Browse our catalog and request a quote</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light text-center py-5">
                            <i class="fas fa-image fa-4x text-muted"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <p class="card-text">
                            <strong>Base Price:</strong> @product.BasePrice.ToString("C")
                        </p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#quoteModal@(product.Id)">
                            <i class="fas fa-file-invoice"></i> Request Quote
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quote Modal for each product -->
            <div class="modal fade" id="quoteModal@(product.Id)" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title">Request Quote for @product.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="RequestQuote" asp-controller="Client" method="post" enctype="multipart/form-data">
                            <div class="modal-body">
                                <input type="hidden" name="ProductId" value="@product.Id" />
                                <div class="mb-3">
                                    <label class="form-label">Quantity</label>
                                    <input type="number" name="Quantity" class="form-control" min="1" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Proposed Price (per unit)</label>
                                    <input type="number" name="ProposedPrice" class="form-control" step="0.01" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Reference Image (Optional)</label>
                                    <input type="file" name="ReferenceImage" class="form-control" accept="image/*" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Submit Quote Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>