@model List<Quote>
@{
    ViewData["Title"] = "All Quotes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-list"></i> All Quotes</h1>
        <a href="/Manager/PendingQuotes" class="btn btn-warning">
            <i class="fas fa-clock"></i> View Pending
        </a>
    </div>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>Complete Quote History</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="quotesTable">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Proposed Price</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Request Date</th>
                            <th>Reviewed Date</th>
                            <th>Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quote in Model.OrderByDescending(q => q.RequestDate))
                        {
                            <tr>
                                <td>@quote.User.FirstName @quote.User.LastName</td>
                                <td>@quote.Product.Name</td>
                                <td>@quote.Quantity</td>
                                <td>@quote.ProposedPrice.ToString("C")</td>
                                <td>@((quote.Quantity * quote.ProposedPrice).ToString("C"))</td>
                                <td>
                                    @if (quote.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (quote.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (quote.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else if (quote.Status == "Paid")
                                    {
                                        <span class="badge bg-info">Paid</span>
                                    }
                                </td>
                                <td>@quote.RequestDate.ToString("MMM dd, yyyy")</td>
                                <td>@(quote.ReviewedDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td><small>@quote.ManagerComments</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#quotesTable').DataTable({
                "order": [[ 6, "desc" ]],
                "pageLength": 25
            });
        });
    </script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
}