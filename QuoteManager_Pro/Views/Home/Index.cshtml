@{
    ViewData["Title"] = "Welcome";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">Welcome to QuoteManager Pro</h1>
        <p class="lead">Your trusted B2B quote management solution</p>
    </div>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="row justify-content-center mt-5">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h3>Get Started</h3>
                        <p>Register as a client to request quotes or login as manager to manage requests.</p>
                        <a href="/Account/Register" class="btn btn-primary btn-lg">Register Now</a>
                        <a href="/Account/Login" class="btn btn-outline-secondary btn-lg ms-2">Login</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mt-5">
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow">
                    <div class="card-body text-center">
                        <i class="fas fa-box fa-3x text-primary mb-3"></i>
                        <h4>Browse Products</h4>
                        <p>Explore our product catalog and request quotes for items you need.</p>
                        @if (User.IsInRole("Client"))
                        {
                            <a href="/Product/List" class="btn btn-primary">View Products</a>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow">
                    <div class="card-body text-center">
                        <i class="fas fa-file-invoice fa-3x text-success mb-3"></i>
                        <h4>Your Quotes</h4>
                        <p>Track the status of all your quote requests.</p>
                        @if (User.IsInRole("Client"))
                        {
                            <a href="/Client/Dashboard" class="btn btn-success">View Dashboard</a>
                        }
                    </div>
                </div>
            </div>
            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow">
                        <div class="card-body text-center">
                            <i class="fas fa-tasks fa-3x text-warning mb-3"></i>
                            <h4>Manage Quotes</h4>
                            <p>Review and process pending quote requests.</p>
                            <a href="/Manager/PendingQuotes" class="btn btn-warning">Manage Quotes</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>